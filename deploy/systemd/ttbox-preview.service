[Unit]
Description=TTBOX Preview Plugin
After=local-fs.target
# 不 Wants ttbox-core：TTBOX core 需独占 HDMI RX，按需手动启动
# ★ 以下两行 StartLimit* 必须放在 [Unit] 段——写在 [Service] 段会被 systemd 静默忽略
#   （日志明说 "Unknown key name 'StartLimitIntervalSec' in section 'Service', ignoring"），
#   限流一旦失效，失败重启就是无限刷（板端曾 82 次/31 分钟）。
#   勿"顺手挪回" [Service] 段；ttbox_release_verify.sh 会断言此段位，挪走即 FAIL。
StartLimitBurst=5
StartLimitIntervalSec=300

[Service]
Type=simple
# 运行用户（T02 方案 A）：与 Core 同组 ttbox，方可连接 /run/ttbox/core.sock（0660）
User=ttbox
Group=ttbox
# 路径随 release 走（DEP-06 / design §B1.1）：current -> releases/<ver>/，树内含 plugins/preview。
WorkingDirectory=/opt/ttbox/current/plugins/preview
ExecStart=/opt/ttbox/current/plugins/preview/bin/ttbox-preview
# IPC socket 唯一真源（T01）：与 Core 的 --ipc 及默认值保持一致
Environment=TTBOX_IPC_SOCKET=/run/ttbox/core.sock
Environment=TTBOX_PREVIEW_HOST=127.0.0.1
Environment=TTBOX_PREVIEW_PORT=8001
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
