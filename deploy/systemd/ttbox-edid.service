[Unit]
Description=TTBOX EDID Inject (oneshot)
After=systemd-modules-load.service

[Service]
Type=oneshot
# 统一 EDID 脚本入口（T02）：此前 ttbox-edid.service / deploy/DEPENDENCIES.md /
# ttbox-web.py 三处指向各不相同；统一到 /opt/ttbox/current/scripts/edid/edid_apply.sh
#
# T1.04（DEP-02）启动链路非致命化：EDID 注入是【可选】步骤——
#   PC 源未接 / EDID 节点未就绪 / 协商超时，一律不得令本 unit 进入 failed 态、更不得拖挂启动链。
#   · timeout 20s 兜住脚本内部重试（最多 12 轮，每轮含 sleep）的最坏耗时，避免长时间挂起；
#   · `|| true` 令失败/超时只 WARN、unit 退出 0（core 照常启动并推理）。
#   失败仍是【可观测】的：journal 会留下下面这行 [ttbox-edid][WARN]。
#   （Web 端手动应用 EDID 走的是另一条路径——直接调 edid_apply.sh 并看其退出码，
#     不受本处"非致命"包裹影响。）
ExecStart=/bin/sh -c 'timeout 20s /opt/ttbox/current/scripts/edid/edid_apply.sh || echo "[ttbox-edid][WARN] EDID 注入失败或超时（可选步骤，非致命；core 照常启动并推理）"'
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
